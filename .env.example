# Server Configuration
PORT=3000
NODE_ENV=development
JWT_SECRET=fleetlink_super_secret_jwt_key_2026

# Meta WhatsApp Cloud API Configuration
WHATSAPP_TOKEN=EAABbC...
PHONE_NUMBER_ID=109283746501928
WEBHOOK_VERIFY_TOKEN=fleetlink_secure_verify_token_99
META_APP_SECRET=a1b2c3d4e5f67890

# Default Business Rules
DEFAULT_MIN_KM_PER_DAY=250
DEFAULT_NIGHT_START_HOUR=22
DEFAULT_NIGHT_END_HOUR=6

# OpenRouteService (https://openrouteservice.org/dev/#/signup) - free API key,
# used to auto-calculate trip distance from pickup/drop location names in the WhatsApp bot.
ORS_API_KEY=

# Google Gemini (https://aistudio.google.com/apikey) - free API key, used to understand
# free-form customer messages ("Chennai to Madurai this Friday, need an SUV") in the WhatsApp bot.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
